# Copie este arquivo para .env e preencha com os dados do seu projeto.
# A chave do Gemini e a service_role NUNCA podem começar com VITE_.

# Frontend (públicas — protegidas pelas políticas RLS do Supabase)
VITE_APP_URL=https://contas-ivory.vercel.app
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon

# Backend / funções serverless da Vercel
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# E-mail que pode abrir o painel de cadastros. Separe vários com vírgula.
# Não use o prefixo VITE_.
ADMIN_EMAIL=seu_email@exemplo.com

# Inteligência artificial — só no servidor
GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-2.5-flash
